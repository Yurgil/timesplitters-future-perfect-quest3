 #ifdef TSFP_OPENXR
+/* A guest offscreen pass keeps its normal 2D target and shader. Only its
+ * companion view and sampled scene copies change when replaying the right eye. */
+static int xr_prepare_right_frame(RhiImage *image)
+{
+    if (image->xr_right_frame)
+        return 1;
+    if (image->swapchain || image->xr_layers || image->desc.samples != 1 ||
+        image->desc.type != RHI_IMAGE_2D || image->desc.depth != 1 ||
+        image->desc.mip_levels != 1 || !(image->desc.bind & RHI_BIND_RENDER_TARGET))
+        return 0;
+
+    RhiImageDesc desc = image->desc;
+    desc.bind = RHI_BIND_SAMPLED | RHI_BIND_RENDER_TARGET;
+    RhiImage *right = v_image_create(&desc, NULL);
+    if (!right)
+        return 0;
+    RhiView *sampled = v_view_create(right, RHI_VIEW_SAMPLED, NULL);
+    RhiView *target = v_view_create(right, RHI_VIEW_RENDER_TARGET, NULL);
+    v_image_destroy(right);
+    if (!sampled || !target) {
+        if (sampled) v_view_destroy(sampled);
+        if (target) v_view_destroy(target);
+        return 0;
+    }
+    image->xr_right_frame = sampled;
+    image->xr_right_target = target;
+    return 1;
+}
