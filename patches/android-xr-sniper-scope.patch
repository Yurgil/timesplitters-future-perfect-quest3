+RhiView *tsfp_vk_scope_finish(void)
+{
+    if (!V.xr_scope_recording)
+        return NULL;
+    V.xr_scope_recording = 0;
+    end_rendering();
+    if (!V.xr_scope_drawn || !tsfp_vk_scope_supported())
+        return NULL;
+    RhiImage *source = V.xr_world_color;
+    if (!V.xr_scope_image) {
+        const RhiImageDesc desc = {.type = RHI_IMAGE_2D, .format = source->desc.format,
+            .width = 768, .height = 768, .depth = 1, .mip_levels = 1, .samples = 1,
+            .bind = RHI_BIND_SAMPLED};
+        RhiImage *image = v_image_create(&desc, NULL);
+        if (!image)
+            return NULL;
+        V.xr_scope_image = v_view_create(image, RHI_VIEW_SAMPLED, NULL);
+        v_image_destroy(image);
+        if (!V.xr_scope_image)
+            return NULL;
+    }
+
+    RhiImage *scope = V.xr_scope_image->image;
+    const VkImageLayout restore = source->layout;
+    to_layout(source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    to_layout(scope, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    const VkImageBlit blit = {
+        .srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, XR_SCOPE_LAYER, 1},
+        .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+        .srcOffsets = {{0, 0, 0}, {(int32_t)source->desc.width, (int32_t)source->desc.height, 1}},
+        .dstOffsets = {{0, 0, 0}, {(int32_t)scope->desc.width, (int32_t)scope->desc.height, 1}},
+    };
+    vkCmdBlitImage(cmd(), source->image, source->layout, scope->image, scope->layout,
+                   1, &blit, VK_FILTER_NEAREST);
+    to_layout(scope, scope->steady);
+    to_layout(source, restore);
+    return V.xr_scope_image;
 }
 
