--- /dev/null
+++ b/src/runtime/host_maps_text.h
@@ -0,0 +1,49 @@
+#ifndef TSFP_HOST_MAPS_TEXT_H
+#define TSFP_HOST_MAPS_TEXT_H
+
+#include <stdint.h>
+
+static inline const char *tsfp_map_hex(const char *text, uintptr_t *value)
+{
+    const char *start = text;
+    uintptr_t result = 0;
+    for (;; ++text) {
+        unsigned c = (unsigned char)*text;
+        unsigned digit = c - '0';
+        if (digit > 9) {
+            digit = (c | 0x20u) - 'a';
+            if (digit > 5)
+                break;
+            digit += 10;
+        }
+        if (result > (UINTPTR_MAX >> 4))
+            return 0;
+        result = (result << 4) | digit;
+    }
+    if (text == start)
+        return 0;
+    *value = result;
+    return text;
+}
+
+/* Linux /proc/self/maps begins with hex-start, hex-end and four permissions. */
+static inline const char *tsfp_map_line(const char *line, uintptr_t *lo, uintptr_t *hi)
+{
+    const char *text = tsfp_map_hex(line, lo);
+    if (!text || *text != '-')
+        return 0;
+    text = tsfp_map_hex(text + 1, hi);
+    if (!text || *hi <= *lo || (*text != ' ' && *text != '\t'))
+        return 0;
+    do {
+        ++text;
+    } while (*text == ' ' || *text == '\t');
+    if ((text[0] != 'r' && text[0] != '-') ||
+        (text[1] != 'w' && text[1] != '-') ||
+        (text[2] != 'x' && text[2] != '-') ||
+        (text[3] != 'p' && text[3] != 's'))
+        return 0;
+    return text;
+}
+
+#endif
