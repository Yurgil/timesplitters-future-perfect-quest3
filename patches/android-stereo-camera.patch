+#ifdef TSFP_QUEST_STEREO_PROBE
+static void quest_avatar_clip(void)
+{
+    extern int tsfp_stereo_avatar_after_cull(uint32_t entity);
+    extern void sub_000A1DC0(void);
+    /* A79B0 clips the entities in the world draw bucket. Other callers
+     * also use A2430 for visibility checks unrelated to rendering. */
+    const uint32_t player = FP_MEM32(0x007B0C7Cu);
+    const uint32_t entity = FP_MEM32(g_esp + 4);
+    const int local = FP_MEM32(g_esp) == 0x000A79EBu &&
+        player && entity && entity == FP_MEM32(player + 0x14u);
+    sub_000A2430_gen();
+    if (!local || !tsfp_stereo_avatar_after_cull(entity))
+        return;
+
+    /* The stock culled path skips allocating and evaluating the animated
+     * model. Use the same preparation called by the visible path. */
+    const uint32_t flags = FP_MEM32(entity + 0x28u);
+    if ((flags & 0x00300000u) == 0x00100000u) {
+        const uint32_t stack = g_esp;
+        g_esp = stack - 8;
+        FP_MEM32(g_esp) = 0x000A79EBu;
+        FP_MEM32(g_esp + 4) = entity;
+        sub_000A1DC0();
+        g_esp = stack;
+    }
+    g_eax = 0;
+}
+#endif
