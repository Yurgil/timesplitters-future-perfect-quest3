+int tsfp_vk_stereo_snapshot_extent(uint32_t *width, uint32_t *height)
+{
+    const RhiImage *source = V.xr_world_color;
+    /* A copy can be captured before the scope that samples it. Keep full
+     * snapshots at scene resolution so every compositor sees sharp inputs. */
+    if (!V.xr_world_active || !source || !source->xr_layers)
+        return 0;
+    *width = source->desc.width;
+    *height = source->desc.height;
+    return 1;
+}
+
+int tsfp_vk_stereo_effect_extent(uint32_t *width, uint32_t *height)
+{
+    return tsfp_stereo_screen_effect_draw() && tsfp_vk_stereo_snapshot_extent(width, height);
+}
