+#ifdef TSFP_OPENXR
+int tsfp_vk_cinematic_matte(uint32_t caller, int top, float edge)
+{
+    if (!V.xr_world_active || !xr_world_target() || !begin_rendering() || (V.view_mask & 3u) != 3u)
+        return 0;
+    const uint32_t y = (uint32_t)(fminf(1.0f, fmaxf(0.0f, edge)) * V.area.height + 0.5f);
+    const uint32_t height = top ? y : V.area.height - y;
+    if (height) {
+        const VkClearAttachment black = {
+            .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+            .colorAttachment = 0,
+            .clearValue.color.float32 = { 0, 0, 0, 1 },
+        };
+        const VkClearRect band = {
+            .rect = { { 0, top ? 0 : (int32_t)y }, { V.area.width, height } },
+            .layerCount = 1,
+        };
+        vkCmdClearAttachments(cmd(), 1, &black, 1, &band);
+#ifndef TSFP_RELEASE
+        static uint32_t reported[6];
+        for (unsigned i = 0; i < sizeof reported / sizeof reported[0]; ++i) {
+            if (reported[i] == caller)
+                break;
+            if (!reported[i]) {
+                reported[i] = caller;
+                fprintf(stderr, "[XR-MATTE] guest=%08x y=%d rect=%ux%u target=%ux%u eyes=%u\n",
+                        caller, band.rect.offset.y, V.area.width, height,
+                        V.area.width, V.area.height, V.view_mask);
+                break;
+            }
+        }
+#else
+        (void)caller;
+#endif
+    }
+    return 1;
+}
+#endif
 
