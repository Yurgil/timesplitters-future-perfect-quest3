+int tsfp_vk_stereo_snapshot(RhiImage *destination)
+{
+    RhiImage *source = V.xr_world_color;
+    if (!V.xr_world_active || !source || !source->xr_layers || destination == source ||
+        destination->desc.samples != 1 || destination->desc.type != RHI_IMAGE_2D ||
+        destination->desc.depth != 1 || !(destination->desc.bind & RHI_BIND_SAMPLED))
+        return 0;
+
+    if (!destination->xr_right_frame) {
+        VkFormatProperties src, dst;
+        vkGetPhysicalDeviceFormatProperties(V.pd, source->format, &src);
+        vkGetPhysicalDeviceFormatProperties(V.pd, destination->format, &dst);
+        if (!(src.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_SRC_BIT) ||
+            !(dst.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_DST_BIT))
+            return 0;
+        RhiImageDesc desc = destination->desc;
+        desc.bind = RHI_BIND_SAMPLED;
+        desc.mip_levels = 1;
+        RhiImage *right = v_image_create(&desc, NULL);
+        if (!right)
+            return 0;
+        destination->xr_right_frame = v_view_create(right, RHI_VIEW_SAMPLED, NULL);
+        v_image_destroy(right);
+        if (!destination->xr_right_frame)
+            return 0;
+    }
+
+    end_rendering();
+    const VkImageLayout restore = source->layout;
+    to_layout(source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    RhiImage *frames[] = {destination, destination->xr_right_frame->image};
+    for (uint32_t eye = 0; eye < 2; ++eye) {
+        RhiImage *frame = frames[eye];
+        const VkImageBlit blit = {
+            .srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, eye, 1},
+            .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+            .srcOffsets = {{0, 0, 0}, {(int32_t)source->desc.width, (int32_t)source->desc.height, 1}},
+            .dstOffsets = {{0, 0, 0}, {(int32_t)frame->desc.width, (int32_t)frame->desc.height, 1}},
+        };
+        to_layout(frame, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+        vkCmdBlitImage(cmd(), source->image, source->layout, frame->image, frame->layout,
+                       1, &blit, VK_FILTER_NEAREST);
+        to_layout(frame, frame->steady);
+    }
+    to_layout(source, restore);
+    destination->xr_frame_copy = destination->xr_frame_paired = 1;
+    static int reported;
+    if (!reported) {
+        reported = 1;
+        fprintf(stderr, "[XR] Captured separate %ux%u screen effects snapshots for both eyes\n",
+                destination->desc.width, destination->desc.height);
+    }
+    return 1;
+}
