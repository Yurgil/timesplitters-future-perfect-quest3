+#ifdef __ANDROID__
+/* The RTL lock path validates a single readable byte for its identity.
+ * Query it without scanning /proc/self/maps. The syscall honors the current
+ * page permissions, including changes made since the previous lock call. */
+static int guest_vm_readable_byte(uintptr_t address)
+{
+    unsigned char byte;
+    const struct iovec local = { &byte, 1 };
+    const struct iovec remote = { (void *)address, 1 };
+    const int saved_errno = errno;
+    const ssize_t result = process_vm_readv(getpid(), &local, 1, &remote, 1, 0);
+    const int inaccessible = result < 0 && errno == EFAULT;
+    errno = saved_errno;
+    return result == 1 ? 1 : inaccessible ? 0 : -1;
+}
+#endif
