+    if (V.xr_world_active && V.xr_world_color && V.xr_world_color->xr_layers)
+        V.xr_avatar_capture = tsfp_xr_avatar_capture_begin(V.xr_world_color);
+}
+
+void tsfp_vk_avatar_capture_end(void)
+{
+    if (V.xr_avatar_capture) {
+        tsfp_xr_avatar_capture_end(V.xr_world_color, V.xr_avatar_capture);
+        V.xr_avatar_capture = 0;
+    }
+}
