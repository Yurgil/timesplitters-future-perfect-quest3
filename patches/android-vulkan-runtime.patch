+#ifdef TSFP_OPENXR
+static RhiBuffer *v_buffer_create(const RhiBufferDesc *d, const void *initial);
+static void v_buffer_destroy(RhiBuffer *b);
+static void v_buffer_update(RhiBuffer *b, const void *data);
+
+static _Thread_local int xr_allocating;
+
+int tsfp_vk_stereo_geometry(void)
+{
+    return V.xr_eye_constants && V.xr_identity_constants;
+}
+
+void tsfp_vk_stereo_size(uint32_t *width, uint32_t *height)
+{
+    const VkExtent2D extent = tsfp_xr_geometry_extent();
+    if (V.feat_multiview && tsfp_xr_geometry_enabled() && extent.width && extent.height) {
+        *width = extent.width;
+        *height = extent.height;
+    }
+}
+
+int tsfp_vk_stereo_allocating(int active)
+{
+    if (active && V.feat_multiview && tsfp_xr_geometry_enabled() && !tsfp_vk_stereo_geometry()) {
+        const RhiBufferDesc desc = { .size = 32 * sizeof(float), .usage = RHI_USAGE_DYNAMIC, .bind = RHI_BIND_UNIFORM };
+        float identity[32] = {0};
+        for (unsigned i = 0; i < 4; ++i)
+            identity[i * 5] = identity[16 + i * 5] = 1.0f;
+        V.xr_eye_constants = v_buffer_create(&desc, identity);
+        V.xr_identity_constants = v_buffer_create(&desc, identity);
+        if (!tsfp_vk_stereo_geometry()) {
+            if (V.xr_eye_constants) v_buffer_destroy(V.xr_eye_constants);
+            if (V.xr_identity_constants) v_buffer_destroy(V.xr_identity_constants);
+            V.xr_eye_constants = V.xr_identity_constants = NULL;
+        } else {
+            V.xr_weapon_constants = v_buffer_create(&desc, identity);
+            V.xr_body_constants = v_buffer_create(&desc, identity);
+            for (unsigned role = TSFP_MODEL_LEFT_WEAPON; role < TSFP_MODEL_TRACKED_COUNT; ++role)
+                V.xr_tracked_constants[role] = v_buffer_create(&desc, identity);
+        }
+    }
+    xr_allocating = active && tsfp_vk_stereo_geometry();
+    return xr_allocating;
+}
+
+void tsfp_vk_stereo_world(RhiImage *color)
+{
+    V.xr_world_color = color;
+}
+
+void tsfp_vk_stereo_frame_copy(RhiImage *image, int full_frame)
